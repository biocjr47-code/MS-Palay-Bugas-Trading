# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is git-ignored. Never commit it.

[supabase]
# Supabase Dashboard > Project Settings > API
url = "https://YOUR-PROJECT-REF.supabase.co"
# Use the SECRET key (sb_secret_...) or legacy service_role key: Streamlit keeps it on the server.
key = "YOUR-SECRET-KEY"

[app]
# Asked only once, to create the first owner account. After that, everyone logs in with their own username.
setup_code = "choose-a-long-random-code"
